# Environment Variables for Daamitha Gallery
# Copy this file to .env and update with your values

# ===========================================
# Server Configuration
# ===========================================
PORT=3000
NODE_ENV=production

# ===========================================
# Better Auth (Unified Authentication)
# ===========================================
# Secret for signing tokens - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Production URL (your Railway domain)
BETTER_AUTH_URL=https://wonderful-grace-production-d7f3.up.railway.app

# ===========================================
# Google OAuth & Gmail API
# ===========================================
# From Google Cloud Console: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# For Gmail API (sending emails)
# Generate using: node scripts/get-gmail-token.js
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Gmail sender address
GMAIL_SENDER_EMAIL=daamitha@daamitha.gallery

# ===========================================
# AI Assistant (Anthropic Claude)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===========================================
# Polar Payments (Optional)
# ===========================================
# POLAR_ACCESS_TOKEN=polar_at_xxxxx
# POLAR_ORGANIZATION_ID=your_org_id
# POLAR_WEBHOOK_SECRET=your_webhook_secret
