# Environment Variables Example
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=change_this_to_a_very_long_random_string_in_production

# Admin Credentials
ADMIN_EMAIL=admin@daamitha.art
ADMIN_PASSWORD=Admin@123

# Flowise Configuration (optional)
# FLOWISE_API_HOST=http://localhost:3000
# FLOWISE_CHATFLOW_ID=your-chatflow-id