# Environment Variables Example
# Copy this file to .env and update with your values

# ===========================================
# Server Configuration
# ===========================================
PORT=3000
NODE_ENV=production

# ===========================================
# Legacy Admin Authentication (JWT)
# ===========================================
JWT_SECRET=change_this_to_a_very_long_random_string_in_production

# Admin Credentials (for gallery management)
ADMIN_EMAIL=admin@daamitha.art
ADMIN_PASSWORD=Admin@123

# ===========================================
# AI Assistant (Anthropic)
# ===========================================
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===========================================
# Better Auth (Client Authentication)
# ===========================================
# Secret for signing tokens - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Base URL for auth callbacks
BETTER_AUTH_URL=https://yourdomain.com

# ===========================================
# Google OAuth & Gmail API
# ===========================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Enable Gmail API and OAuth consent screen

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# For Gmail API (sending emails)
# Get refresh token via OAuth playground: https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Gmail sender address (must match authenticated account)
GMAIL_SENDER_EMAIL=daamitha@daamitha.art

# ===========================================
# Polar Payments
# ===========================================
# Get from: https://polar.sh/settings/developers
POLAR_ACCESS_TOKEN=polar_at_xxxxx
POLAR_ORGANIZATION_ID=your_org_id

# Webhook secret for payment notifications
POLAR_WEBHOOK_SECRET=your_webhook_secret

# ===========================================
# Optional: Legacy Integrations
# ===========================================
# FLOWISE_API_HOST=http://localhost:3000
# FLOWISE_CHATFLOW_ID=your-chatflow-id
# CHATKIT_WORKFLOW_ID=your-workflow-id
